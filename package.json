{
  "name": "streameo",
  "version": "3.2.0",
  "private": true,
  "description": "StreamEo static cinema frontend",
  "scripts": {
    "dev": "python3 -m http.server 3000 --bind 0.0.0.0",
    "test": "npm run test:syntax && npm run test:unit && npm run test:browser",
    "test:syntax": "node tests/check-syntax.cjs",
    "test:unit": "node --test tests/*.unit.cjs",
    "test:browser": "playwright test",
    "vendor:hls": "node scripts/vendor-hls.cjs",
    "release:package": "python3 scripts/package-release.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
  "dependencies": {
    "hls.js": "1.5.17"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "GPL-3.0-only"
}
